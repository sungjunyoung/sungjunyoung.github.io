---
import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  tags?: readonly string[];
  image?: { src: string; width: number; height: number };
  noindex?: boolean;
}

const { title, description, type, publishedAt, tags, image, noindex } = Astro.props;

// Hugo's baseof.html: "<Title> :: <Site.Title>" for inner pages, bare site title at home.
const isHome = Astro.url.pathname === '/';
const pageTitle = isHome ? SITE.title : `${title} :: ${SITE.title}`;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <BaseHead
      title={pageTitle}
      socialTitle={isHome ? SITE.title : title}
      description={description}
      type={type}
      publishedAt={publishedAt}
      tags={tags}
      image={image}
      noindex={noindex}
    />
    <!-- Swaps the document instead of reloading it, and turns on link
         prefetching in the same move. src/scripts/page.ts is what keeps the
         widgets bound across a swap; nothing on the page may rely on a module
         body running once per navigation. -->
    <ClientRouter />
    <script is:inline>
      // Apply the stored theme before first paint so the page never flashes.
      (function () {
        try {
          var stored = window.localStorage.getItem('theme');
          document.documentElement.dataset.initialTheme =
            stored === 'light-theme' || stored === 'dark-theme' ? stored : 'dark-theme';
        } catch (e) {
          document.documentElement.dataset.initialTheme = 'dark-theme';
        }
      })();
    </script>
  </head>
  <body class="dark-theme">
    <script is:inline>
      document.body.className = document.documentElement.dataset.initialTheme;
    </script>
    <ReadingProgress />

    <div class="container">
      <Header />

      <div class="content">
        <slot />
      </div>

      <Footer />
    </div>

    <script>
      import '../scripts/page';
    </script>
  </body>
</html>
