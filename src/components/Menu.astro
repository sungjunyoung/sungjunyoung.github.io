---
import { MENU } from '../consts';
---

<nav class="menu">
  <ul class="menu__inner menu__inner--desktop">
    {MENU.map((item) => (
      <li><a href={item.url}>{item.name}</a></li>
    ))}
  </ul>

  <ul class="menu__inner menu__inner--mobile">
    {MENU.map((item) => (
      <li><a href={item.url}>{item.name}</a></li>
    ))}
  </ul>
</nav>
