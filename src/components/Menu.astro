---
import { MENU } from '../consts';
---

{/* One list, shown at every width. The menu holds a single link, so it costs
    less room in the header than the button that used to hide it did. */}
<nav class="menu">
  <ul class="menu__inner">
    {MENU.map((item) => (
      <li><a href={item.url}>{item.name}</a></li>
    ))}
  </ul>
</nav>
