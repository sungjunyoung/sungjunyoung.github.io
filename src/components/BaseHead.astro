---
import { SITE } from "../consts";
import { metaDescription } from "../utils/excerpt";

interface Props {
  /** Full <title> text, already suffixed with the site name where appropriate. */
  title: string;
  /** Bare page/post title, used for social cards where og:site_name carries the suffix. */
  socialTitle?: string;
  description?: string;
  type?: "website" | "article";
  publishedAt?: Date;
  tags?: readonly string[];
  /** Post-specific social image, resolved by astro:assets; falls back to the site card. */
  image?: { src: string; width: number; height: number };
  /** Set on pages that duplicate another URL's content. */
  noindex?: boolean;
}

const {
  title,
  socialTitle,
  description,
  type = "website",
  publishedAt,
  tags = [],
  image,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
// A post with its own cover supplies one image; otherwise the site card is
// offered twice — the animated GIF first, then a static PNG for scrapers that
// skip GIF rather than rendering its first frame.
const cards = image
  ? [
      {
        url: new URL(image.src, Astro.site).href,
        type: undefined,
        width: image.width,
        height: image.height,
      },
    ]
  : [
      {
        url: new URL(SITE.ogImage, Astro.site).href,
        type: "image/gif",
        width: SITE.ogImageWidth,
        height: SITE.ogImageHeight,
      },
      {
        url: new URL(SITE.ogImageFallback, Astro.site).href,
        type: "image/png",
        width: SITE.ogImageWidth,
        height: SITE.ogImageHeight,
      },
    ];
// X's handling of animated GIFs in cards is unreliable, so it always gets a still.
const twitterImage = image
  ? cards[0]!.url
  : new URL(SITE.ogImageFallback, Astro.site).href;
const cardTitle = socialTitle ?? title;
// `|| ` rather than `??` so an empty string also falls back — the home page
// used to ship `<meta name="description" content>` because of this.
const summary = metaDescription(description || SITE.description);

// Google reads publisher/author from structured data; without it a personal blog
// shows up as a bare link. Articles describe themselves, everything else
// describes the site.
const person = {
  "@type": "Person",
  name: SITE.author,
  url: SITE.url,
  sameAs: [SITE.github, SITE.linkedin],
};

const jsonLd =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: cardTitle,
        description: summary,
        image: cards[0]!.url,
        url: canonical,
        mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
        datePublished: publishedAt?.toISOString(),
        dateModified: publishedAt?.toISOString(),
        inLanguage: SITE.lang,
        keywords: tags.join(", ") || undefined,
        author: person,
        publisher: person,
      }
    : {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: SITE.title,
        description: SITE.description,
        url: SITE.url,
        inLanguage: SITE.lang,
        author: person,
      };
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content={summary} />
<meta name="author" content={SITE.author} />
{noindex && <meta name="robots" content="noindex, follow" />}
<link rel="canonical" href={canonical} />

<!-- AdSense (was layouts/partials/prepended_head.html) -->
<script
  is:inline
  async
  src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`}
  crossorigin="anonymous"></script>
<meta name="google-adsense-account" content={SITE.adsenseClient} />

<title>{title}</title>

<!-- Icons -->
<link
  rel="apple-touch-icon-precomposed"
  sizes="144x144"
  href="/img/apple-touch-icon-144-precomposed.png"
/>
<link rel="shortcut icon" href="/img/favicon.png" />

<!-- Fonts: Pretendard, as the dynamic subset so a page downloads only the
     unicode-range chunks its own text needs. The version is pinned so the
     glyphs cannot shift under an already published post. -->
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/pretendard@1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.css"
/>

<!-- OpenGraph -->
<meta property="og:site_name" content={SITE.title} />
<meta property="og:title" content={cardTitle} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:description" content={summary} />
<meta property="og:locale" content={SITE.locale} />
{cards.map((card) => (
  <>
    <meta property="og:image" content={card.url} />
    {card.type && <meta property="og:image:type" content={card.type} />}
    <meta property="og:image:width" content={String(card.width)} />
    <meta property="og:image:height" content={String(card.height)} />
    <meta property="og:image:alt" content={cardTitle} />
  </>
))}
{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{type === "article" && <meta property="article:author" content={SITE.author} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={cardTitle} />
<meta name="twitter:description" content={summary} />
<meta name="twitter:image" content={twitterImage} />
<meta name="twitter:image:alt" content={cardTitle} />

<!-- RSS | sitemap -->
<link rel="alternate" type="application/rss+xml" href="/index.xml" title={SITE.title} />
<link rel="sitemap" href="/sitemap-index.xml" />

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

<!-- Google Analytics -->
<script
  is:inline
  async
  src={`https://www.googletagmanager.com/gtag/js?id=${SITE.googleAnalyticsId}`}></script>
<script is:inline define:vars={{ gaId: SITE.googleAnalyticsId }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag("js", new Date());
  gtag("config", gaId);
</script>
