---
import { SITE } from '../consts';
---

{/* Lives in the post layout's left rail — see .post-rail in post.css. That
    column exists to hold the article in the middle of the page band, so it was
    empty; these sit at the bottom of it, out of the reading column but on
    screen for the whole scroll. */}
<div class="post-actions">
  <a
    class="post-action"
    href={SITE.linkedin}
    target="_blank"
    rel="noopener"
    aria-label="LinkedIn 프로필 열기"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3V9zm7 0h3.8v1.65h.05c.53-.95 1.83-1.95 3.76-1.95 4.02 0 4.76 2.5 4.76 5.76V21h-4v-5.72c0-1.36-.03-3.12-1.95-3.12-1.95 0-2.25 1.49-2.25 3.02V21h-4V9z"
      ></path>
    </svg>
  </a>

  <button class="post-action" type="button" data-copy-url aria-label="이 글의 주소 복사">
    <svg class="post-action__icon post-action__icon--link" viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M10.6 13.4a1 1 0 0 1 0-1.42l2.83-2.82a1 1 0 0 1 1.41 1.41l-2.82 2.83a1 1 0 0 1-1.42 0zm-1.06 3.18-1.42 1.42a2.5 2.5 0 0 1-3.54-3.54l2.83-2.83a2.5 2.5 0 0 1 3.54 0 1 1 0 0 0 1.41-1.41 4.5 4.5 0 0 0-6.36 0L3.17 13.05a4.5 4.5 0 0 0 6.36 6.36l1.42-1.41a1 1 0 1 0-1.41-1.42zm11.29-12.3a4.5 4.5 0 0 0-6.36 0l-1.42 1.41a1 1 0 0 0 1.41 1.42l1.42-1.42a2.5 2.5 0 0 1 3.54 3.54l-2.83 2.83a2.5 2.5 0 0 1-3.54 0 1 1 0 0 0-1.41 1.41 4.5 4.5 0 0 0 6.36 0l2.83-2.83a4.5 4.5 0 0 0 0-6.36z"
      ></path>
    </svg>
    <svg class="post-action__icon post-action__icon--check" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M9.6 16.2 4.8 11.4l-1.4 1.4 6.2 6.2 12-12-1.4-1.4z"></path>
    </svg>
  </button>

  {/* The glyph swap is the feedback for anyone who can see it; this is the
      same message for anyone who cannot. */}
  <span class="visually-hidden" role="status" data-copy-status></span>
</div>
