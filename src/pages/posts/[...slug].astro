---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import Comments from '../../components/Comments.astro';
import { getPosts, postUrl, type Post } from '../../utils/posts';
import { excerpt } from '../../utils/excerpt';
import { formatDate, LABELS } from '../../consts';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPosts();

  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      // Hugo's .NextInSection is the newer post, .PrevInSection the older one.
      newer: posts[i - 1] ?? null,
      older: posts[i + 1] ?? null,
    },
  }));
};

interface Props {
  post: Post;
  newer: Post | null;
  older: Post | null;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const description = post.data.description ?? excerpt(post.body ?? '');
---

<Base
  title={post.data.title}
  description={description}
  type="article"
  publishedAt={post.data.date}
  tags={post.data.tags}
  image={post.data.cover}
>
  <div class="post-layout">
    <article class="post">
      <h1 class="post-title">{post.data.title}</h1>
      <div class="post-meta">
        <time class="post-date" datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
      </div>

      {post.data.tags.length > 0 && (
        <span class="post-tags">
          {post.data.tags.map((tag) => (
            <Fragment><a href={`/tags/${tag}/`}>#{tag}</a>&nbsp;</Fragment>
          ))}
        </span>
      )}

      <div class="post-content">
        <Content />
      </div>

      {(newer || older) && (
        <div class="pagination">
          <div class="pagination__title">
            <span class="pagination__title-h">{LABELS.readOtherPosts}</span>
            <hr />
          </div>
          <div class="pagination__buttons">
            {newer && (
              <span class="button previous">
                <a href={postUrl(newer)}>
                  <span class="button__icon">←</span>
                  <span class="button__text">{newer.data.title}</span>
                </a>
              </span>
            )}
            {older && (
              <span class="button next">
                <a href={postUrl(older)}>
                  <span class="button__text">{older.data.title}</span>
                  <span class="button__icon">→</span>
                </a>
              </span>
            )}
          </div>
        </div>
      )}

      <Comments />
    </article>

    {post.data.toc && <TableOfContents headings={headings} />}
  </div>
</Base>
