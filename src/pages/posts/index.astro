---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, postUrl } from '../../utils/posts';
import { excerpt } from '../../utils/excerpt';

const posts = await getPosts();
---

{/* This page lists exactly what "/" lists, so it is kept out of the
    index to avoid competing with the home page for the same content. */}
<Base title="Posts" noindex>
  <div class="posts">
    {posts.map((post) => (
      <PostCard
        href={postUrl(post)}
        title={post.data.title}
        date={post.data.date}
        tags={post.data.tags}
        summary={post.data.description ?? excerpt(post.body ?? '')}
      />
    ))}
  </div>
</Base>
