---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts, postUrl } from '../utils/posts';
import { excerpt } from '../utils/excerpt';
import { readingMinutes } from '../utils/readingTime';
import { SITE, LABELS } from '../consts';

const posts = await getPosts();
const page = posts.slice(0, SITE.postsPerPage);
const hasNext = posts.length > SITE.postsPerPage;

// The newest post gets the whole first row to itself; everything after it runs
// two to a row on desktop and one on a phone.
const [lead, ...rest] = page;
---

<Base title={SITE.title}>
  <div class="posts">
    {lead && (
      <PostCard
        featured
        cover={lead.data.cover}
        coverDark={lead.data.coverDark}
        href={postUrl(lead)}
        title={lead.data.title}
        date={lead.data.date}
        tags={lead.data.tags}
        minutes={readingMinutes(lead.body ?? '')}
        summary={lead.data.description ?? excerpt(lead.body ?? '')}
      />
    )}

    {rest.length > 0 && (
      <div class="posts__grid">
        {rest.map((post) => (
          <PostCard
            href={postUrl(post)}
            title={post.data.title}
            date={post.data.date}
            tags={post.data.tags}
            minutes={readingMinutes(post.body ?? '')}
            summary={post.data.description ?? excerpt(post.body ?? '')}
          />
        ))}
      </div>
    )}

    <div class="pagination">
      <div class="pagination__buttons">
        {hasNext && (
          <span class="button next">
            <a href="/page/2/">
              <span class="button__text">{LABELS.olderPosts}</span>
              <span class="button__icon">→</span>
            </a>
          </span>
        )}
      </div>
    </div>
  </div>
</Base>
