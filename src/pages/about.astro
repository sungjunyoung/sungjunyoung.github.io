---

<Base title={PAGE.title}>
  <div class="about">
    {/* The lead reads like the index's lead card: it takes the full band on its
        own, and the rule under it opens the two-column part of the page. */}
    <section class="about__lead">
      <h1 class="post-title">{PAGE.title}</h1>
      <div class="post-meta">
        <time datetime={PAGE.date.toISOString()}>{formatDate(PAGE.date)}</time>
        <span class="post-author">— Written by {PAGE.author}</span>
      </div>

      <Image class="about__portrait" src={profile} alt={PAGE.author} width={200} height={200} />
      <p class="about__tagline">❤️ {PAGE.tagline}</p>
    </section>

    <div class="about__row">
      <section class="about__section">
        <h2>📧 Contact</h2>
        <dl class="about__pairs">
          {CONTACT.map((row) => (
            <>
              <dt>{row.label}</dt>
              <dd>
                {row.links.map((link, i) => (
                  <>
                    {i > 0 && ' / '}
                    <a href={link.href}>{link.text}</a>
                  </>
                ))}
              </dd>
            </>
          ))}
        </dl>
      </section>

      <section class="about__section">
        <h2>🔗 Channel</h2>
        <dl class="about__pairs">
          {CHANNEL.map((row) => (
            <>
              <dt>{row.label}</dt>
              <dd>
                {row.links.map((link) => <a href={link.href}>{link.text}</a>)}
              </dd>
            </>
          ))}
        </dl>
      </section>
    </div>

    <div class="about__row">
      <section class="about__section">
        <h2>🐜 Career</h2>
        <ul class="about__list">
          {CAREER.map((job) => (
            <li>
              <span class="about__when">{job.period}</span>
              <span class="about__what">
                <a href={job.href}>{job.org}</a> : {job.role}
              </span>
            </li>
          ))}
        </ul>
      </section>

      <section class="about__section">
        <h2>📺 Presentations</h2>
        <ul class="about__list">
          {PRESENTATIONS.map((item) => (
            <li>
              <span class="about__when">{item.when}</span>
              <span class="about__what">
                {item.where}
                {item.talks.map((talk) => (
                  <a class="about__talk" href={talk.href}>{talk.text}</a>
                ))}
              </span>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <section class="about__section about__section--full">
      <h2>🎉 Awards</h2>
      {/* Seven entries down a 1140px band would run the page on for another
          screen and a half, so they take the same two tracks the sections above
          them do. */}
      <ul class="about__list about__list--split">
        {AWARDS.map((award) => (
          <li>
            <span class="about__when">{award.when}</span>
            <span class="about__what">
              {award.where} : {award.prize}
              <span class="about__notes">
                {award.notes.map((note) => (
                  <span class="about__note">
                    {note.map((part) =>
                      part.href ? <a href={part.href}>{part.text}</a> : part.text,
                    )}
                  </span>
                ))}
              </span>
            </span>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
